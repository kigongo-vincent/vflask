"""CLI commands for {{ project_name }}."""

from __future__ import annotations

import os
import socket
import subprocess
from pathlib import Path

import click
from pyfiglet import Figlet
from dotenv import load_dotenv

load_dotenv()

from app import create_app
from app.extensions import db
from app.shared.models import User
from app.shared.rbac import RBACService


@click.group()
def main() -> None:
    """{{ project_name }} CLI."""
    pass


def _run_app(host: str, port: int, debug: bool) -> None:
    port = _next_available_port(host, port)
    os.environ["APP_BASE_URL"] = f"http://{host}:{port}"
    _print_startup_banner()
    click.echo(f"Starting {{project_name}} at http://{host}:{port}")
    app = create_app()
    app.run(host=host, port=port, debug=debug)


def _next_available_port(host: str, port: int) -> int:
    for candidate in range(port, 65536):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
            try:
                probe.bind((host, candidate))
            except OSError:
                continue
            return candidate
    raise click.ClickException(f"No available port found at or above {port}")


def _print_startup_banner() -> None:
    click.echo(Figlet(font="big").renderText("VFLASK").rstrip())
    credit = "by Kigongo Vincent"
    border = "+" + "-" * (len(credit) + 2) + "+"
    click.echo("\n".join((
        border,
        f"| {credit} |",
        border,
    )))


@main.command("run")
@click.option("--host", default="127.0.0.1", show_default=True, help="Host interface for the Flask dev server.")
@click.option("--port", default=5000, type=click.IntRange(1, 65535), show_default=True, help="Port for the Flask dev server.")
@click.option("--debug/--no-debug", default=True, show_default=True, help="Enable Flask debug reloader.")
def run_app(host: str, port: int, debug: bool) -> None:
    """Run the generated application locally."""
    _run_app(host=host, port=port, debug=debug)


@main.command("start")
@click.option("--host", default="127.0.0.1", show_default=True, help="Host interface for the Flask dev server.")
@click.option("--port", default=5000, type=click.IntRange(1, 65535), show_default=True, help="Port for the Flask dev server.")
@click.option("--debug/--no-debug", default=True, show_default=True, help="Enable Flask debug reloader.")
def start_app(host: str, port: int, debug: bool) -> None:
    """Alias for starting the app locally."""
    _run_app(host=host, port=port, debug=debug)


@main.command()
def init_db() -> None:
    """Create missing tables and seed default roles."""
    app = create_app()
    with app.app_context():
        db.create_all()
        RBACService.seed_roles()
        click.echo("✅ Database tables and default roles are ready")


@main.command("push")
@click.argument("message", required=False, default="chore: update project")
def push_project(message: str) -> None:
    """Stage, commit, and push the generated app project to git."""
    repo_root = Path(__file__).resolve().parents[1]

    subprocess.run(["git", "status", "--short"], cwd=repo_root, check=True)
    subprocess.run(["git", "add", "."], cwd=repo_root, check=True)

    try:
        subprocess.run(["git", "commit", "-m", message], cwd=repo_root, check=True)
    except subprocess.CalledProcessError:
        click.echo("ℹ️ No changes to commit.")
        return

    subprocess.run(["git", "push"], cwd=repo_root, check=True)
    click.echo("✅ Changes pushed successfully.")


@main.command()
@click.argument("email")
@click.argument("password")
@click.argument("name")
def create_user(email: str, password: str, name: str) -> None:
    """Create a new user."""
    app = create_app()
    with app.app_context():
        user = User()
        user.email = email
        user.name = name
        user.is_active = True
        user.set_password(password)
        db.session.add(user)
        db.session.commit()
        click.echo(f"✅ Created user: {email}")


if __name__ == "__main__":
    main()