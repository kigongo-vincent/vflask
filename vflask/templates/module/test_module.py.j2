def _endpoint_data() -> JSONObject:
    data = _sample_data()
{% for field in fields if field.type in ('date', 'datetime') %}
    value = data.get("{{ field.name }}")
    if isinstance(value, (date, datetime)):
        data["{{ field.name }}"] = value.isoformat()
{% endfor %}
    return data


def _response_data(response: TestResponse) -> JSONObject:
    return json_object(cast(object, response.get_json()))


def _response_payload(response: TestResponse) -> JSONObject:
    payload = _response_data(response).get("data")
    assert isinstance(payload, dict)
    return payload


