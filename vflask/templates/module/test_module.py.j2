from datetime import datetime, timezone

from app.modules.{{ module.table_name }}.models import {{ module.class_name }}


def test_{{ module.singular }}_model_field_names() -> None:
    assert {{ module.class_name }}.id is not None
    {% for field in fields %}
    assert {{ module.class_name }}.{{ field.name }} is not None
    {% endfor %}


def test_{{ module.singular }}_serialization_returns_declared_fields() -> None:
    now = datetime.now(timezone.utc)
    item = {{ module.class_name }}()
    item.id = 1
{% for field in fields %}
    item.{{ field.name }} = {{ field.test_value }}
{% endfor %}
{% if not fields %}
    item.name = "example"
{% endif %}
    item.created_at = now
    item.updated_at = now

    data = item.to_dict()
    assert data["id"] == 1
{% for field in fields %}
    assert "{{ field.name }}" in data
{% endfor %}
    assert "createdAt" in data
    assert "updatedAt" in data


def test_{{ module.singular }}_service_can_be_constructed() -> None:
    from app.modules.{{ module.table_name }}.service import {{ module.class_name }}Service

    assert isinstance({{ module.class_name }}Service(), {{ module.class_name }}Service)
