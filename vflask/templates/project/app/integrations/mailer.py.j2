from __future__ import annotations

import os
import smtplib
from email.message import EmailMessage
from importlib import import_module
from typing import Protocol, cast


class MailProvider(Protocol):
    def send(self, *, to: str, subject: str, text: str, html: str | None = None) -> None: ...


class SMTPMailProvider:
    def send(self, *, to: str, subject: str, text: str, html: str | None = None) -> None:
        host = os.getenv("SMTP_HOST")
        sender = os.getenv("MAIL_FROM_ADDRESS")
        if not host or not sender:
            raise RuntimeError("SMTP_HOST and MAIL_FROM_ADDRESS are required for SMTP mail")
        message = EmailMessage()
        message["From"] = sender
        message["To"] = to
        message["Subject"] = subject
        message.set_content(text)
        if html:
            message.add_alternative(html, subtype="html")
        port = int(os.getenv("SMTP_PORT", "587"))
        connection_type = smtplib.SMTP_SSL if port == 465 else smtplib.SMTP
        with connection_type(host, port, timeout=20) as server:
            if port != 465:
                server.starttls()
            username = os.getenv("SMTP_USERNAME")
            password = os.getenv("SMTP_PASSWORD")
            if username and password:
                server.login(username, password)
            server.send_message(message)


class AWSSESMailProvider:
    def send(self, *, to: str, subject: str, text: str, html: str | None = None) -> None:
        import boto3

        sender = os.getenv("MAIL_FROM_ADDRESS")
        if not sender:
            raise RuntimeError("MAIL_FROM_ADDRESS is required for Amazon SES")
        body: dict[str, dict[str, str]] = {"Text": {"Data": text, "Charset": "UTF-8"}}
        if html:
            body["Html"] = {"Data": html, "Charset": "UTF-8"}
        boto3.client("ses", region_name=os.getenv("AWS_REGION", "us-east-1")).send_email(
            Source=sender,
            Destination={"ToAddresses": [to]},
            Message={
                "Subject": {"Data": subject, "Charset": "UTF-8"},
                "Body": body,
            },
        )


def _load_custom_provider() -> MailProvider | None:
    class_path = os.getenv("MAIL_PROVIDER_CLASS")
    if not class_path:
        return None
    module_name, separator, class_name = class_path.rpartition(".")
    if not separator:
        raise ValueError("MAIL_PROVIDER_CLASS must be a dotted Python class path")
    provider_class = getattr(import_module(module_name), class_name)
    return cast(MailProvider, provider_class())


def get_mailer() -> MailProvider:
    custom_provider = _load_custom_provider()
    if custom_provider:
        return custom_provider
    name = os.getenv("MAIL_PROVIDER", "smtp").lower()
    if name == "smtp":
        return SMTPMailProvider()
    if name == "ses":
        return AWSSESMailProvider()
    raise ValueError(f"Unsupported MAIL_PROVIDER: {name}")