{% if 'u' in crud_mode %}
    def update_{{ module.singular }}(self, item_id: int, updates: JSONObject) -> {{ module.class_name }} | None:
        """Update an existing {{ module.singular }}."""
        item = self.get_{{ module.singular }}(item_id)
        if not item or item.deleted_at:
            return None
    {% if needs_date_import %}
        normalized_updates = _coerce_input(updates)
    {% else %}
        normalized_updates = updates
    {% endif %}
        for key, value in normalized_updates.items():
            if hasattr(item, key):
                setattr(item, key, value)
        self.db.session.commit()
        return item
{% endif %}

{% if 'd' in crud_mode %}
    def delete_{{ module.singular }}(self, item_id: int) -> bool:
        """Soft delete a {{ module.singular }}."""
        item = self.get_{{ module.singular }}(item_id)
        if not item:
            return False
        item.soft_delete()
        self.db.session.commit()
        return True

    def bulk_delete(self, ids: list[int]) -> int:
        """Soft delete multiple {{ module.table_name }}."""
        count = 0
        for item in self.db.session.query({{ module.class_name }}).filter({{ module.class_name }}.id.in_(ids)):
            item.soft_delete()
            count += 1
        self.db.session.commit()
        return count
    {% endif %}