def test_{{ module.singular }}_service_reads_and_searches_records(app: Flask) -> None:
    with app.app_context():
        service = {{ module.class_name }}Service()
        item = service.create_{{ module.singular }}(_sample_data())
        rows, total = service.list_{{ module.table_name }}(
            {"pagination": {"page": 1, "limit": 10}}
        )
        assert total == 1
        assert [row.id for row in rows] == [item.id]
        assert service.get_{{ module.singular }}(item.id) is item
        assert service.get_{{ module.singular }}(-1) is None
{% if not fields or fields | selectattr('type', 'in', ['string', 'text']) | list %}
        search_value = str(_sample_data()["{% if fields %}{{ (fields | selectattr('type', 'in', ['string', 'text']) | first).name }}{% else %}name{% endif %}"])
        search_rows, search_total = service.list_{{ module.table_name }}(
            {"pagination": {"page": 1, "limit": 10}, "search": search_value}
        )
        assert search_total == 1
        assert [row.id for row in search_rows] == [item.id]
{% endif %}


