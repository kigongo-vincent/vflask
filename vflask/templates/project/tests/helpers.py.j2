"""Test helpers."""

from __future__ import annotations

from collections.abc import Mapping

from app.base.types import JSONObject, json_object


def http(client, method: str, path: str, body: JSONObject | None = None, headers: Mapping[str, str] | None = None) -> JSONObject:
    """Make HTTP request and return JSON response."""
    clean_path = path.lstrip("/")
    res = client.open(
        f"/api/v1/{clean_path}",
        method=method,
        json=body,
        headers=headers or {},
    )
    assert res.status_code < 500, f"Server Error ({res.status_code}): {res.get_data(as_text=True)}"
    return json_object(res.get_json())