{% if 'r' in crud_mode %}
def test_{{ module.singular }}_http_reads_and_validates_pagination(
    client: FlaskClient, auth_headers: dict[str, str]
) -> None:
    create_response = client.post(
        "{{ module.url_prefix }}/", json=_endpoint_data(), headers=auth_headers
    )
    item_id = _response_payload(create_response).get("id")
    assert isinstance(item_id, int)

    list_response = client.post(
        "{{ module.url_prefix }}/list",
        json={"pagination": {"page": 1, "limit": 10}},
        headers=auth_headers,
    )
    assert list_response.status_code == 200
    assert _response_payload(list_response)["total"] == 1
    assert client.get(
        f"{{ module.url_prefix }}/{item_id}", headers=auth_headers
    ).status_code == 200

    invalid_response = client.post(
        "{{ module.url_prefix }}/list",
        json={"pagination": {"page": 1, "limit": 101}},
        headers=auth_headers,
    )
    assert invalid_response.status_code == 400
{% endif %}

