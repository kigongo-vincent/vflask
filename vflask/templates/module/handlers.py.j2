from app.base.types import JSONObject, json_object
from app.modules.{{ module.table_name }}.service import {{ module.class_name }}Service


class {{ module.class_name }}Handler:
    """Handle HTTP requests for {{ module.plural_class }}."""

    def __init__(self) -> None:
        self.service = {{ module.class_name }}Service()

{% if 'r' in crud_mode %}
    def list(self) -> tuple[Response, int]:
        """List {{ module.table_name }} with pagination and filters."""
        req = json_object(request.get_json(silent=True))
        pagination_value = req.get("pagination", {})
        if not isinstance(pagination_value, dict):
            return api_error("Invalid payload: pagination with page and limit required")
        pagination = pagination_value

        page_value = pagination.get("page")
        limit_value = pagination.get("limit")
        if not isinstance(page_value, (int, str)) or isinstance(page_value, bool):
            return api_error("Invalid payload: pagination with page and limit required")
        if not isinstance(limit_value, (int, str)) or isinstance(limit_value, bool):
            return api_error("Invalid payload: pagination with page and limit required")

        try:
            page = int(page_value)
            limit = int(limit_value)
        except (TypeError, ValueError):
            return api_error("Invalid payload: pagination with page and limit required")

        if page <= 0 or limit <= 0 or limit > 100:
            return api_error("Invalid payload: pagination with page and limit required; limit > 100 is not allowed")

        req["pagination"] = {"page": page, "limit": limit}
        try:
            items, total = self.service.list_{{ module.table_name }}(req)
        except ValueError as e:
            return api_error(str(e))
        except Exception as e:
            return api_error(str(e), 500)

        return paginated_response(
            [item.to_dict() for item in items],
            total,
            page,
            limit,
        )
{% endif %}

{% if 'c' in crud_mode %}
    def create(self) -> tuple[Response, int]:
        """Create a new {{ module.singular }}."""
        body: JSONObject = json_object(request.get_json(silent=True))
        if not body:
            return api_error("Invalid payload")
        try:
            item = self.service.create_{{ module.singular }}(body)
        except Exception as e:
            return api_error(str(e), 500)
        return api_ok(item.to_dict(), msg="created", status=201)
{% endif %}

{% if 'r' in crud_mode %}
    def get(self, item_id: int) -> tuple[Response, int]:
        """Get a single {{ module.singular }}."""
        item = self.service.get_{{ module.singular }}(item_id)
        if not item or item.deleted_at:
            return api_error("{{ module.class_name }} not found", 404)
        return api_ok(item.to_dict())
{% endif %}

{% if 'u' in crud_mode %}
    def update(self, item_id: int) -> tuple[Response, int]:
        """Update a {{ module.singular }}."""
        body: JSONObject = json_object(request.get_json(silent=True))
        item = self.service.update_{{ module.singular }}(item_id, body)
        if not item:
            return api_error("{{ module.class_name }} not found", 404)
        return api_ok(item.to_dict(), msg="updated")
{% endif %}

{% if 'd' in crud_mode %}
    def delete(self, item_id: int) -> tuple[Response, int]:
        """Soft delete a {{ module.singular }}."""
        if not self.service.delete_{{ module.singular }}(item_id):
            return api_error("{{ module.class_name }} not found", 404)
        return api_ok(msg="deleted")

    def bulk_delete(self) -> tuple[Response, int]:
        """Soft delete multiple {{ module.table_name }}."""
        body: JSONObject = json_object(request.get_json(silent=True))
        ids = body.get("ids", [])
        if not isinstance(ids, list) or not all(
            isinstance(item, int) and not isinstance(item, bool) for item in ids
        ):
            return api_error("Invalid payload: ids array required")
        count = self.service.bulk_delete([item for item in ids if isinstance(item, int)])
        return api_ok({"deleted": count}, msg="bulk deleted successfully")
    {% endif %}