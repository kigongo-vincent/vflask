from __future__ import annotations

import os
import re
from importlib import import_module
from pathlib import Path
from typing import cast

from flask import Flask
from sqlalchemy import Boolean, Column, Date, DateTime, Float, Integer, Numeric, String, Text, inspect
from sqlalchemy.orm import Mapper

from app.base.types import JSONObject, json_object
from app.extensions import db
from app.shared.models import Role, User


def _column_schema(column: Column[object]) -> dict[str, object]:
    column_type = column.type
    if isinstance(column_type, Boolean):
        schema: dict[str, object] = {"type": "boolean"}
    elif isinstance(column_type, Integer):
        schema = {"type": "integer"}
    elif isinstance(column_type, (Float, Numeric)):
        schema = {"type": "number"}
    elif isinstance(column_type, DateTime):
        schema = {"type": "string", "format": "date-time"}
    elif isinstance(column_type, Date):
        schema = {"type": "string", "format": "date"}
    elif isinstance(column_type, Text):
        schema = {"type": "string"}
    elif isinstance(column_type, String):
        schema = {"type": "string"}
        if column_type.length:
            schema["maxLength"] = column_type.length
    else:
        schema = {"type": "string"}

    if column.nullable:
        schema["nullable"] = True
    return schema


def _model_schemas() -> tuple[dict[str, dict[str, object]], dict[str, type[object]]]:
    schemas: dict[str, dict[str, object]] = {}
    models: dict[str, type[object]] = {"roles": Role, "users": User}
    aliases = {"created_at": "createdAt", "updated_at": "updatedAt", "is_active": "isActive"}

    modules_dir = Path(__file__).resolve().parent.parent / "modules"
    for module_dir in sorted(modules_dir.iterdir(), key=lambda item: item.name):
        model_path = module_dir / "models.py"
        if not module_dir.is_dir() or not model_path.is_file():
            continue
        model_module = import_module(f"app.modules.{module_dir.name}.models")
        for attribute_name in dir(model_module):
            candidate = cast(object, getattr(model_module, attribute_name))
            table_name = getattr(candidate, "__tablename__", None)
            if isinstance(candidate, type) and isinstance(table_name, str):
                models[table_name] = cast(type[object], candidate)

    for table_name, model in models.items():
        mapper = cast(Mapper[object], inspect(model))

        properties: dict[str, object] = {}
        required: list[str] = []
        for column in mapper.columns:
            if column.key in {"deleted_at", "password_hash"}:
                continue
            if mapper.class_.__name__ == "User" and column.key in {"created_at", "updated_at"}:
                continue
            name = column.key
            if name is None:
                continue
            name = aliases.get(name, name)
            properties[name] = _column_schema(column)
            if not column.nullable:
                required.append(name)

        if mapper.class_.__name__ == "User" and "roles" in mapper.relationships:
            properties["roles"] = {"type": "array", "items": {"type": "string"}}
            required.append("roles")

        schemas[mapper.class_.__name__] = {
            "type": "object",
            "properties": properties,
            "required": required,
        }
        models[table_name] = model

    return schemas, models


def _reference(name: str) -> dict[str, object]:
    return {"$ref": f"#/components/schemas/{name}"}


def _envelope(data_schema: object) -> dict[str, object]:
    return {
        "type": "object",
        "properties": {
            "status": {"type": "integer"},
            "msg": {"type": "string"},
            "data": data_schema,
        },
        "required": ["status", "msg", "data"],
    }


def _request_body(schema: dict[str, object]) -> dict[str, object]:
    return {
        "required": True,
        "content": {"application/json": {"schema": schema}},
    }


def _auth_request_schema(name: str) -> dict[str, object] | None:
    fields: dict[str, dict[str, object]] = {
        "email": {"type": "string", "format": "email"},
        "password": {"type": "string", "format": "password"},
        "name": {"type": "string"},
        "otp": {"type": "string", "minLength": 6, "maxLength": 6},
        "code": {"type": "string"},
        "state": {"type": "string"},
    }
    contracts = {
        "signup": ("email", "password", "name"),
        "login": ("email", "password"),
        "request_otp": ("email",),
        "forgot_password": ("email",),
        "reset_password": ("email", "otp", "password"),
        "update_profile": (),
        "google_oauth_callback": ("code", "state"),
    }
    required = contracts.get(name)
    if required is None:
        return None
    if name == "update_profile":
        properties = {key: fields[key] for key in ("email", "password", "name")}
    else:
        properties = {key: fields[key] for key in required}
    schema: dict[str, object] = {"type": "object", "properties": properties}
    if required:
        schema["required"] = list(required)
    return schema


def _api_error_schema() -> dict[str, object]:
    return _envelope({"type": "null"})


def _path_parameter(name: str) -> dict[str, object]:
    return {
        "name": name,
        "in": "path",
        "required": True,
        "schema": {"type": "integer" if name.endswith("_id") else "string"},
    }


def build_openapi_spec(app: Flask) -> JSONObject:
    api_prefix = "/api/v1"
    server_url = os.getenv("APP_BASE_URL", "http://127.0.0.1:5000").rstrip("/")
    model_schemas, models = _model_schemas()
    components: dict[str, object] = {
        "schemas": {
            **model_schemas,
            "ErrorResponse": _api_error_schema(),
        },
        "securitySchemes": {
            "BearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
        },
    }
    paths: dict[str, dict[str, object]] = {}
    tags: dict[str, dict[str, object]] = {}
    protected_auth = {"verify_token", "refresh_token", "me", "update_profile", "logout"}

    for rule in app.url_map.iter_rules():
        if not rule.rule.startswith(f"{api_prefix}/") or rule.endpoint in {"openapi_document", "api_docs"}:
            continue

        endpoint = rule.endpoint
        blueprint = endpoint.partition(".")[0] if "." in endpoint else "system"
        auth_endpoint = endpoint.rsplit(".", 1)[-1] if blueprint == "auth" else ""
        module_model = models.get(blueprint)
        tag_name = blueprint if blueprint != "system" else "system"
        tags[tag_name] = {"name": tag_name}

        openapi_path = re.sub(r"<(?:(?:int|float|string|path):)?([A-Za-z_][A-Za-z0-9_]*)>", r"{\1}", rule.rule)
        path_item = paths.setdefault(openapi_path, {})
        methods = rule.methods
        if methods is None:
            continue
        for method in sorted(methods - {"HEAD", "OPTIONS"}):
            lower_method = method.lower()
            view = app.view_functions.get(endpoint)
            doc = (getattr(view, "__doc__", None) or "").strip().splitlines()
            summary = doc[0].strip(" .") if doc else endpoint.rsplit(".", 1)[-1].replace("_", " ").capitalize()
            responses: dict[str, object] = {}
            operation: dict[str, object] = {
                "operationId": re.sub(r"[^A-Za-z0-9_]", "_", endpoint + "_" + lower_method),
                "summary": summary,
                "tags": [tag_name],
                "responses": responses,
            }

            path_parameters = re.findall(r"\{([A-Za-z_][A-Za-z0-9_]*)\}", openapi_path)
            if path_parameters:
                operation["parameters"] = [_path_parameter(name) for name in path_parameters]
            if blueprint == "auth" and auth_endpoint == "google_oauth_callback" and lower_method == "get":
                operation["parameters"] = [
                    {"name": name, "in": "query", "required": True, "schema": {"type": "string"}}
                    for name in ("code", "state")
                ]

            requires_auth = blueprint != "system" and (blueprint != "auth" or auth_endpoint in protected_auth)
            if requires_auth:
                operation["security"] = [{"BearerAuth": []}]
                responses["401"] = {
                    "description": "Authentication required or token invalid",
                    "content": {"application/json": {"schema": _reference("ErrorResponse")}},
                }

            if blueprint == "auth":
                request_schema = _auth_request_schema(auth_endpoint)
                if request_schema and lower_method in {"post", "put", "patch"}:
                    operation["requestBody"] = _request_body(request_schema)
                if auth_endpoint in {"signup", "login", "refresh_token"}:
                    data_schema = {
                        "type": "object",
                        "properties": {
                            "token": {"type": "string"},
                            "refresh_token": {"type": "string"},
                            "user": _reference("User"),
                        },
                    }
                elif auth_endpoint in {"verify_token"}:
                    data_schema = {
                        "type": "object",
                        "properties": {"valid": {"type": "boolean"}, "user": _reference("User")},
                    }
                elif auth_endpoint in {"me", "update_profile"}:
                    data_schema = {"type": "object", "properties": {"user": _reference("User")}}
                elif auth_endpoint == "google_authorization_url":
                    data_schema = {
                        "type": "object",
                        "properties": {
                            "authorization_url": {"type": "string", "format": "uri"},
                            "state": {"type": "string"},
                            "redirect_uri": {"type": "string", "format": "uri"},
                        },
                    }
                elif auth_endpoint == "google_oauth_callback":
                    data_schema = {
                        "type": "object",
                        "properties": {
                            "token": {"type": "string"},
                            "refresh_token": {"type": "string"},
                            "user": _reference("User"),
                        },
                    }
                elif auth_endpoint in {"request_otp", "forgot_password"}:
                    data_schema = {
                        "type": "object",
                        "properties": {"otp": {"type": "string"}, "message": {"type": "string"}},
                    }
                else:
                    data_schema = {"type": "object", "properties": {"message": {"type": "string"}}}
            elif module_model:
                model_name = module_model.__name__
                if lower_method in {"post", "put", "patch"}:
                    if openapi_path.endswith("/list"):
                        operation["requestBody"] = _request_body(
                            {
                                "type": "object",
                                "properties": {
                                    "pagination": {
                                        "type": "object",
                                        "properties": {
                                            "page": {"type": "integer", "minimum": 1},
                                            "limit": {"type": "integer", "minimum": 1, "maximum": 100},
                                        },
                                        "required": ["page", "limit"],
                                    },
                                    "columns": {"type": "array", "items": {"type": "object"}},
                                    "search": {"type": "string"},
                                },
                                "required": ["pagination"],
                            }
                        )
                    elif "bulk-delete" in openapi_path:
                        operation["requestBody"] = _request_body(
                            {"type": "object", "properties": {"ids": {"type": "array", "items": {"type": "integer"}}}, "required": ["ids"]}
                        )
                    else:
                        input_properties: dict[str, object] = {}
                        input_required: list[str] = []
                        module_mapper = cast(Mapper[object], inspect(module_model))
                        for column in module_mapper.columns:
                            if column.key in {"id", "created_at", "updated_at", "deleted_at"}:
                                continue
                            column_name = column.key
                            if column_name is None:
                                continue
                            input_properties[column_name] = _column_schema(column)
                            if not column.nullable and column.default is None:
                                input_required.append(column_name)
                        input_schema: dict[str, object] = {"type": "object", "properties": input_properties}
                        if lower_method == "post" and input_required:
                            input_schema["required"] = input_required
                        operation["requestBody"] = _request_body(input_schema)

                if openapi_path.endswith("/list"):
                    data_schema = {
                        "type": "object",
                        "properties": {
                            "items": {"type": "array", "items": _reference(model_name)},
                            "total": {"type": "integer"},
                            "page": {"type": "integer"},
                            "limit": {"type": "integer"},
                        },
                    }
                elif lower_method == "delete":
                    data_schema = {"type": "object", "additionalProperties": True}
                else:
                    data_schema = _reference(model_name)
            elif endpoint == "healthcheck":
                data_schema = {"type": "object", "properties": {"status": {"type": "string"}}}
            else:
                data_schema = {"type": "object", "additionalProperties": True}

            success_status = "201" if lower_method == "post" and (auth_endpoint == "signup" or (blueprint != "auth" and not openapi_path.endswith(("/list", "bulk-delete")))) else "200"
            responses[success_status] = {
                "description": "Successful response",
                "content": {"application/json": {"schema": _envelope(data_schema)}},
            }
            responses["400"] = {
                "description": "Invalid request",
                "content": {"application/json": {"schema": _reference("ErrorResponse")}},
            }
            path_item[lower_method] = operation

    return json_object({
        "openapi": "3.0.3",
        "info": {"title": app.name.replace("_", " ").title() + " API", "version": "1.0.0"},
        "servers": [{"url": server_url, "description": "Local development server"}],
        "tags": list(tags.values()),
        "paths": paths,
        "components": components,
    })