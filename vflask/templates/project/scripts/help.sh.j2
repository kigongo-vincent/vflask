#!/usr/bin/env bash
set -euo pipefail

echo "{{ project_name }} terminal commands"
echo ""
echo "  python -m app.cli run                        Start the generated app locally"
echo "  python -m app.cli start                     Alias for starting the app"
echo "  python -m app.cli init-db                  Create tables and seed default roles"
echo "  python -m app.cli create-user <email> <password> <name>  Create a user"
echo "  python -m app.cli push \"message\"            Commit and push project changes to origin"
echo "  python -m app.cli --help                   Show the generated app command list"
echo ""
echo "Project tooling:"
echo "  vflask new <project> --path .                 Create a new project scaffold"
echo "  vflask module create <module> -f ...         Generate a typed module with routes, services, tests, and migrations"
echo "  vflask run --project-root .                  Run the app locally with local services by default"
echo "  vflask run --project-root . --no-services    Run against your own Postgres and Redis services"
echo "  vflask watch --project-root .               Watch the project and regenerate module docs"
echo ""
echo "Release notes:"
echo "  Package versions start at 1.0.0 and can use v-prefixed tags such as v1.2.3 for newer releases."
echo "  First publish creates a missing PyPI project; repeated uploads of the same version are skipped."
echo ""
echo "Examples:"
echo "  vflask new bookstore --path ."
echo "  vflask module create products -f name:string:required -f price:decimal:required -r admin"
echo "  python -m app.cli run"
