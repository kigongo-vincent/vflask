name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
      - run: python -m pip install --upgrade pip
      - run: pip install -r requirements-dev.txt
      - run: pytest -q
      - run: pyright
      - run: python -m compileall -q app tests migrations
      - run: docker compose up --build --detach --wait app
      - run: curl --fail --retry 10 --retry-connrefused http://127.0.0.1:5000/api/v1/health
      - if: always()
        run: docker compose down --volumes