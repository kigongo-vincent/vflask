def test_{{ module.singular }}_model_field_names() -> None:
    model_fields = {column.name for column in {{ module.class_name }}.__table__.columns}
    assert "id" in model_fields
    {% for field in fields %}
    assert "{{ field.name }}" in model_fields
    {% endfor %}


def test_{{ module.singular }}_serialization_returns_declared_fields() -> None:
    now = datetime.now(timezone.utc)
    item = {{ module.class_name }}(
        id=1,
{% for field in fields %}
        {{ field.name }}={{ field.test_value }},
{% endfor %}
{% if not fields %}
        name="example",
{% endif %}
        created_at=now,
        updated_at=now,
    )

    data = item.to_dict()
    assert data["id"] == 1
{% for field in fields %}
    assert "{{ field.name }}" in data
{% endfor %}
    assert "createdAt" in data
    assert "updatedAt" in data


def test_{{ module.singular }}_service_can_be_constructed() -> None:
