from __future__ import annotations

import os
from importlib import import_module
from typing import Any, Protocol, cast

import requests


class PaymentProvider(Protocol):
    def create_payment(
        self,
        *,
        amount: float,
        currency: str,
        email: str,
        transaction_reference: str,
        redirect_url: str,
    ) -> dict[str, Any]: ...

    def verify_payment(self, transaction_id: str) -> dict[str, Any]: ...


class FlutterwavePaymentProvider:
    """Flutterwave adapter; credentials are read only when a request is made."""

    api_url = "https://api.flutterwave.com/v3"

    def _request(self, method: str, path: str, **kwargs: Any) -> dict[str, Any]:
        secret_key = os.getenv("FLW_SECRET_KEY")
        if not secret_key:
            raise RuntimeError("FLW_SECRET_KEY is required for Flutterwave payments")
        response = requests.request(
            method,
            f"{self.api_url}{path}",
            headers={"Authorization": f"Bearer {secret_key}"},
            timeout=20,
            **kwargs,
        )
        response.raise_for_status()
        result = response.json()
        if result.get("status") != "success":
            raise RuntimeError("Flutterwave rejected the payment request")
        return cast(dict[str, Any], result["data"])

    def create_payment(
        self,
        *,
        amount: float,
        currency: str,
        email: str,
        transaction_reference: str,
        redirect_url: str,
    ) -> dict[str, Any]:
        return self._request(
            "POST",
            "/payments",
            json={
                "tx_ref": transaction_reference,
                "amount": amount,
                "currency": currency,
                "redirect_url": redirect_url,
                "customer": {"email": email},
            },
        )

    def verify_payment(self, transaction_id: str) -> dict[str, Any]:
        return self._request("GET", f"/transactions/{transaction_id}/verify")


def _load_custom_provider() -> PaymentProvider | None:
    class_path = os.getenv("PAYMENT_PROVIDER_CLASS")
    if not class_path:
        return None
    module_name, separator, class_name = class_path.rpartition(".")
    if not separator:
        raise ValueError("PAYMENT_PROVIDER_CLASS must be a dotted Python class path")
    provider_class = getattr(import_module(module_name), class_name)
    return cast(PaymentProvider, provider_class())


def get_payment_provider() -> PaymentProvider:
    custom_provider = _load_custom_provider()
    if custom_provider:
        return custom_provider
    name = os.getenv("PAYMENT_PROVIDER", "flutterwave").lower()
    if name == "flutterwave":
        return FlutterwavePaymentProvider()
    raise ValueError(f"Unsupported PAYMENT_PROVIDER: {name}")