{% if 'r' in crud_mode %}
    def list_{{ module.table_name }}(self, req: JSONObject) -> tuple[list[{{ module.class_name }}], int]:
        """List {{ module.table_name }} with filtering and pagination."""
        pagination_value = req.get("pagination", {})
        if not isinstance(pagination_value, dict):
            raise ValueError("pagination with page and limit required")
        pagination = pagination_value
        page = pagination.get("page")
        limit = pagination.get("limit")

        if not isinstance(page, int) or isinstance(page, bool):
            raise ValueError("pagination with page and limit required")
        if not isinstance(limit, int) or isinstance(limit, bool):
            raise ValueError("pagination with page and limit required")

        if page <= 0 or limit <= 0 or limit > 100:
            raise ValueError("pagination with page and limit required; limit > 100 is not allowed")

        query = self.db.session.query({{ module.class_name }})

        # Exclude soft-deleted by default
        columns_value = req.get("columns", [])
        columns = [column for column in columns_value if isinstance(column, dict)] if isinstance(columns_value, list) else []
        if not any(f.get("column") == "trashed" for f in columns):
            query = query.filter({{ module.class_name }}.deleted_at.is_(None))

        # Apply filters
        query = apply_filters(query, {{ module.class_name }}, columns, FILTERABLE)

        # Search
        search_value = req.get("search")
        if isinstance(search_value, str) and search_value:
            term = f"%{search_value}%"
{% if fields | selectattr('type', 'in', ['string', 'text']) | list %}
            query = query.filter(
{% for field in fields if field.type in ('string', 'text') %}
                {{ module.class_name }}.{{ field.name }}.like(term){% if not loop.last %} |{% endif %}
{% endfor %}
            )
{% elif not fields %}
            query = query.filter({{ module.class_name }}.name.like(term))
{% endif %}

        total = query.count()
        rows = (
            query.order_by({{ module.class_name }}.created_at.desc())
            .limit(limit)
            .offset((page - 1) * limit)
            .all()
        )
        return rows, total

    def get_{{ module.singular }}(self, item_id: int) -> {{ module.class_name }} | None:
        """Get a single {{ module.singular }} by ID."""
        return self.db.session.get({{ module.class_name }}, item_id)
{% endif %}

    def create_{{ module.singular }}(self, data: JSONObject) -> {{ module.class_name }}:
        """Create a new {{ module.singular }}."""
    {% if needs_date_import %}
        item = {{ module.class_name }}(**_coerce_input(data))
    {% else %}
        item = {{ module.class_name }}(**data)
    {% endif %}
        self.db.session.add(item)
